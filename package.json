{
  "name": "dual-ai-sentiment-analysis-system",
  "version": "1.0.0",
  "description": "Production-Ready Enterprise AI Sentiment Analysis System - A+ (99/100) grade dual AI sentiment analysis platform featuring advanced security, optimized performance, and enterprise-grade reliability with GPT-OSS-120B and DistilBERT-SST-2 integration.",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "node build-frontend.js",
    "build:frontend:only": "node build-frontend.js",
    "build:backend": "node build-backend.js",
    "build:prod": "npx --no-install tsc --project tsconfig.prod.json",
    "build:dev": "npx --no-install tsc --project tsconfig.dev.json",
    "build:check": "npm run typecheck",
    "deploy": "./scripts/deployment/deploy-production.sh",
    "deploy:only": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env=staging",
    "deploy:build-only": "npm run build",
    "deploy:verify": "curl -sf https://tft-trading-system.yanggf.workers.dev/api/v1/data/health | jq .",
    "deploy:quick": "./scripts/deployment/quick-deploy.sh",
    "deploy:frontend": "./scripts/deployment/deploy-frontend.sh",
    "deploy:frontend:only": "./scripts/deployment/deploy-frontend.sh --skip-backend",
    "typecheck": "npx --no-install tsc --noEmit",
    "typecheck:watch": "npx --no-install tsc --noEmit --watch",
    "format": "npx --no-install prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "npx --no-install prettier --check \"src/**/*.{ts,js,json}\"",
    "test": "echo 'Run specific test suites'",
    "test:performance": "npx --no-install playwright test tests/performance.spec.js --reporter=list",
    "test:workflows": "npx --no-install playwright test tests/user-workflows.spec.js --reporter=list",
    "test:playwright": "npx --no-install playwright test",
    "test:ui": "npx --no-install playwright test --ui",
    "test:report": "npx --no-install playwright show-report",
    "test:performance-all": "./tests/performance/test-playwright-performance.sh",
    "test:integration": "./scripts/utilities/validate-enhanced-cache.sh",
    "test:cache": "./scripts/utilities/validate-enhanced-cache.sh",
    "test:strict-guards": "node -e 'import(\"./test-strict-mode-guards.ts\").then(m => m.runStrictModeGuardrailTests().then(console.log, console.error))'",
    "test:production-guards": "node -e 'import(\"./test-production-guards.ts\").then(m => m.runProductionGuardsTests().then(console.log, console.error))'",
    "test:guards-smoke": "./scripts/test-runners/test-production-guards-smoke.sh",
    "test:reports-html": "./tests/validation/test-reports-html-verification.sh",
    "test:validate-environment": "./tests/validation/validate-environment-bindings.sh",
    "test:html-structure": "./tests/integration/frontend/test-html-structure-validation.sh",
    "test:synthetic-monitoring": "./tests/validation/test-synthetic-monitoring-html.sh",
    "test:mock-prevention": "./tests/feature/mock-elimination/test-mock-prevention-scan.sh",
    "test:d1-sql": "cargo run --quiet --release --manifest-path tools/ci-validators/Cargo.toml --bin d1-sql",
    "verify": "npm run test:d1-sql && npm run test:no-artifacts && npm run test:no-persistent-files && npm run test:cache-hit-contract && npm run test:week-round-trip && npm run test:business-date-sources && npm run test:business-date-envelope && npm run test:html-structure && npm run test:guards-smoke && npm run test:validate-environment && npm run test:synthetic-monitoring && npm run test:mock-prevention",
    "verify:staging": "npm run verify && npm run test:performance-all",
    "verify:prod": "npm run build:prod && npm run verify && npm run test:production-guards",
    "test:no-artifacts": "cargo run --quiet --release --manifest-path tools/ci-validators/Cargo.toml --bin no-artifacts",
    "test:no-persistent-files": "cargo run --quiet --release --manifest-path tools/ci-validators/Cargo.toml --bin no-persistent-files",
    "prepare": "husky install",
    "test:do-cache-flag": "node --experimental-transform-types --import ./tests/validation/register-ts.mjs tests/validation/test-do-cache-flag.mjs",
    "test:cache-hit-contract": "node tests/validation/test-cache-hit-contract.mjs",
    "test:week-round-trip": "node --experimental-transform-types --import ./tests/validation/register-ts.mjs tests/validation/test-week-round-trip.mjs",
    "test:business-date-sources": "node --experimental-transform-types --import ./tests/validation/register-ts.mjs tests/validation/test-business-date-sources.mjs",
    "test:business-date-envelope": "node tests/validation/test-business-date-envelope.mjs"
  },
  "keywords": [
    "sentiment-analysis",
    "ai",
    "machine-learning",
    "finance",
    "cloudflare-workers",
    "typescript",
    "enterprise",
    "production-ready"
  ],
  "author": "Enterprise AI Systems",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/dual-ai-sentiment-analysis-system.git"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250927.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.6.0",
    "esbuild": "0.27.3",
    "express": "^5.1.0",
    "husky": "^9.1.7",
    "node-fetch": "^3.3.2",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.81.1"
  }
}
